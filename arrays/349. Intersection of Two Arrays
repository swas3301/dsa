class Solution(object):
    def intersection(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: List[int]
        """
        res = []
        s1 = set(nums1)
        s2 = set(nums2)
        for i in s1:
            if i in s2 and not in res:
                res.append(i)
                
        return res 